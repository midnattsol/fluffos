#include <tests.h>

mixed saved;

void do_tests() {
  mixed bad = ({ ({ ({ make_error("a", "b") }) }) });
  string file = "/data/save_error_state";

  // The failed save must not leave its nesting depth behind for the next
  // restore, which uses the same counter as an index.
  ASSERT(catch(save_variable(bad)));
  ASSERT_EQ(({ ({ 1 }), ({ 2 }) }), restore_variable("({({1,}),({2,}),})"));
  ASSERT(catch(save_variable(bad)));
  ASSERT_EQ(({ ({ 1 }), ({ 2 }) }), restore_variable(save_variable(({ ({ 1 }), ({ 2 }) }))));

  // A failed save_object leaves neither a partial file nor a replaced save.
  saved = 1;
  rm(file + ".o");
  ASSERT(save_object(file));
  saved = bad;
  for (int i = 0; i < 5; i++) ASSERT(catch(save_object(file)));
  ASSERT_EQ(-1, file_size(file + ".o.tmp"));
  ASSERT(file_size(file + ".o") > 0);
  saved = 0;
  ASSERT(restore_object(file));
  ASSERT_EQ(1, saved);
  rm(file + ".o");
}
