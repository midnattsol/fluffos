#pragma strict_types
#pragma modern_types
#include <tests.h>

bool same(int a, int b) { return a == b; }

void do_tests() {
  int a = 1, b = 2, ran = 0;
  mixed value;
  bool c = a == b;
  bool d = !a;
  bool e = a < b;
  bool f = a >= b;
  bool g = a != b;

  ASSERT(booleanp(c));
  ASSERT(booleanp(d));
  ASSERT(booleanp(e));
  ASSERT(booleanp(f));
  ASSERT(booleanp(g));
  ASSERT(!c);
  ASSERT(!d);
  ASSERT(e);
  ASSERT(!f);
  ASSERT(g);
  ASSERT(booleanp(same(a, b)));
  ASSERT(booleanp(!c));
  ASSERT(booleanp(!!a));
  ASSERT(booleanp(!0));
  ASSERT_EQ("[false,true]", efun::json_encode(({ a == b, a != b })));

  // A condition takes the same branch with or without the conversion.
  if (a == b) ran = -100;
  if (a != b) ran++;
  if (!(a == b)) ran++;
  if (a < b) ran++; else ran = -100;
  if (a == b) { ran = -100; } else { ran++; }
  if (a == b); else ran++;
  ASSERT_EQ(5, ran);
  ASSERT_EQ("yes", (a < b) ? "yes" : "no");
  ASSERT_EQ("yes", !(a < b) ? "no" : "yes");

  ran = 0;
  while (ran < 3) ran++;
  ASSERT_EQ(3, ran);
  do { ran--; } while (ran != 0);
  ASSERT_EQ(0, ran);
  for (a = 0; !(a == 3); a++) ran++;
  ASSERT_EQ(3, ran);

  // Booleans are not integers: an explicit conversion stays possible.
  value = a == a;
  ASSERT(catch(value = value + 1));
  ASSERT_EQ(1, value ? 1 : 0);

  // A mixed holding a bool assigns to a bool variable; anything else is
  // refused with a message that names bool, not class.
  {
    mixed t = true, fl = false, n = 5, str = "x", zero = 0, nul = null;
    mixed arr = ({ true, false });
    null_value nv;
    bool bt, bf, bz;
    bool *ba;
    mixed err;
    string msg;

    bt = t;
    bf = fl;
    ASSERT(booleanp(bt));
    ASSERT(booleanp(bf));
    ASSERT(bt);
    ASSERT(!bf);

    err = catch(bt = n);
    ASSERT(err);
    msg = error_info(err)["message"];
    ASSERT(strsrch(msg, "bool") != -1);
    ASSERT(strsrch(msg, "class") == -1);
    err = catch(bt = str);
    ASSERT(err);
    msg = error_info(err)["message"];
    ASSERT(strsrch(msg, "bool") != -1);
    ASSERT(strsrch(msg, "class") == -1);

    // Integer zero stays allowed by the runtime check.
    ASSERT(!catch(bz = zero));

    ba = arr;
    ASSERT_EQ(2, sizeof(ba));
    ASSERT(booleanp(ba[0]));
    ASSERT(ba[0]);
    ASSERT(!ba[1]);

    nv = nul;
    ASSERT(json_nullp(nv));
    ASSERT(catch(nv = t));
  }
}
