#pragma strict_types
#pragma modern_types
#include <tests.h>

// A counter started from a missing key or an unset local must encode as a plain number. The bug
// reproduced only under the mudlib configuration, so this suite guards the behaviour, not the bug.
void do_tests() {
  mapping post_up = ([]), pre_up = ([]), post_down = ([]), pre_down = ([]);
  int unset_up, unset_down;

  post_up["k"]++;
  ++pre_up["k"];
  post_down["k"]--;
  --pre_down["k"];
  unset_up++;
  unset_down--;

  ASSERT_EQ("{\"k\":1}", json_encode(post_up));
  ASSERT_EQ("{\"k\":1}", json_encode(pre_up));
  ASSERT_EQ("{\"k\":-1}", json_encode(post_down));
  ASSERT_EQ("{\"k\":-1}", json_encode(pre_down));
  ASSERT_EQ("1", json_encode(unset_up));
  ASSERT_EQ("-1", json_encode(unset_down));
  post_up["k"] += 1;
  ASSERT_EQ("{\"k\":2}", json_encode(post_up));
}
